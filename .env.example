# Copy to .env and fill in. NEVER commit your real .env (it is gitignored).
# Load with: set -a; source .env; set +a   (or use direnv / your shell of choice)

# Financial Modeling Prep (historical data). A paid/"massive" plan is
# recommended for deep 1-minute intraday history.
FMP_API_KEY=

# Alpaca Market Data (historical + live). Pro/algo tier unlocks the full SIP
# feed used by alpaca_feed=sip. These are DATA keys; this bot is alert-only and
# does not place live orders.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
